{
  "format_version": 1,
  "title": "E16: Automatic Night Light",
  "board": { "model": "half_size_solderless" },
  "components": [
    { "id": "V1", "kind": "dc_voltage_source", "pins": { "positive": "TP+:1", "negative": "TP-:1" }, "parameters": { "voltage": 5.0 } },
    { "id": "R1", "kind": "resistor", "pins": { "a": "A5", "b": "B8" }, "parameters": { "resistance": 330.0 } },
    { "id": "D1", "kind": "led", "pins": { "anode": "C8", "cathode": "A11" }, "parameters": { "forward_voltage": 2.0, "series_resistance": 20.0 } },
    { "id": "Q1", "kind": "npn_transistor", "pins": { "collector": "B11", "base": "B20", "emitter": "A14" }, "parameters": { "beta": 100.0, "saturation_current": 1e-15 } },
    { "id": "R2", "kind": "resistor", "pins": { "a": "A17", "b": "A20" }, "parameters": { "resistance": 10000.0 } },
    { "id": "R3", "kind": "photoresistor", "pins": { "a": "C20", "b": "A23" }, "parameters": { "min_resistance": 100.0, "max_resistance": 20000.0 } }
  ],
  "wires": [
    { "id": "W1", "from": "B5", "to": "TP+:5" },
    { "id": "W2", "from": "B17", "to": "TP+:17" },
    { "id": "W3", "from": "B14", "to": "TP-:14" },
    { "id": "W4", "from": "B23", "to": "TP-:23" }
  ],
  "initial_conditions": { "control_ratios": { "R3": 0.5 } }
}
